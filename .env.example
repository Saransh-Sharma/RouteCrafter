# RouteCrafter authentication
#
# Copy this file to .env.local for local development.
# In Vercel, set the same keys under Project Settings > Environment Variables.

# Required for JWT session signing and OTP hashing.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Password login for the built-in users in src/lib/auth/users.ts.
USER_ADMIN_PASSWORD="replace-with-admin-password"
USER_SARANSH_PASSWORD="replace-with-saransh-password"
USER_SAUMYA_PASSWORD="replace-with-saumya-password"

# Required in production for auth rate limiting and OTP challenge storage.
# Development falls back to process-local memory when these are omitted.
UPSTASH_REDIS_REST_URL="https://your-upstash-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

# Required in production for Email OTP delivery.
# AUTH_EMAIL_FROM must use a sender or domain verified in Resend.
RESEND_API_KEY="re_replace-with-resend-api-key"
AUTH_EMAIL_FROM="RouteCrafter <login@your-verified-domain.com>"
# RouteCrafter — Authentication
# Copy this to .env.local and fill in values

# Secret key for signing JWTs (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# User passwords (plaintext — fine for private internal tool)
USER_ADMIN_PASSWORD=
USER_SARANSH_PASSWORD=
USER_SAUMYA_PASSWORD=

# (Optional) Resend API key for email OTP
# Sign up at https://resend.com for a free API key
RESEND_API_KEY=

# Required in production when OTP login is enabled
AUTH_EMAIL_FROM=RouteCrafter <login@example.com>

# Required in production for durable OTP challenges and auth rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
